#include <input/processors.dtsi>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

// The touchpad is an Azoteq TPS43 on I2C, at 0x74 on 1.13 SDA / 1.15 SCL with
// 1.14 RST and 0.02 RDY. The original 7-pin Cirque Pinnacle pad used those same
// four lines for SPI (SCK/MOSI/MISO/DR, CS on 0.03); it is not supported here.

// Gesture key bindings. Pick at most one; the default is macOS.
//   TOUCAN_WIN_MODE   Windows/Linux: Ctrl+- / Ctrl+= to zoom, Win+Tab / arrows
//   TOUCAN_NIRI_MODE  niri (Wayland): Super+Page_Up/Down for workspaces,
//                     Super+H/L for columns, Ctrl+- / Ctrl+= to zoom
//#define TOUCAN_WIN_MODE
//#define TOUCAN_NIRI_MODE

// Layers the pad keys off. The keymap is preprocessed on its own, so layer
// names are not visible here; these are the indices in config/toucan.keymap.
// Override them in a keymap that includes this file before it.
#ifndef TOUCAN_LAYER_NAV
#define TOUCAN_LAYER_NAV   1
#endif
#ifndef TOUCAN_LAYER_MOUSE
#define TOUCAN_LAYER_MOUSE 4
#endif

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
        //zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   37       0     0     0>
            , <&key_physical_attrs 100 100  100   37       0     0     0>
            , <&key_physical_attrs 100 100  200   12       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   12       0     0     0>
            , <&key_physical_attrs 100 100  500   24       0     0     0>
            , <&key_physical_attrs 100 100  800   24       0     0     0>
            , <&key_physical_attrs 100 100  900   12       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100   12       0     0     0>
            , <&key_physical_attrs 100 100 1200   37       0     0     0>
            , <&key_physical_attrs 100 100 1300   37       0     0     0>
            , <&key_physical_attrs 100 100    0  137       0     0     0>
            , <&key_physical_attrs 100 100  100  137       0     0     0>
            , <&key_physical_attrs 100 100  200  112       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  112       0     0     0>
            , <&key_physical_attrs 100 100  500  124       0     0     0>
            , <&key_physical_attrs 100 100  800  124       0     0     0>
            , <&key_physical_attrs 100 100  900  112       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  112       0     0     0>
            , <&key_physical_attrs 100 100 1200  137       0     0     0>
            , <&key_physical_attrs 100 100 1300  137       0     0     0>
            , <&key_physical_attrs 100 100    0  237       0     0     0>
            , <&key_physical_attrs 100 100  100  237       0     0     0>
            , <&key_physical_attrs 100 100  200  212       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  212       0     0     0>
            , <&key_physical_attrs 100 100  500  224       0     0     0>
            , <&key_physical_attrs 100 100  800  224       0     0     0>
            , <&key_physical_attrs 100 100  900  212       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  212       0     0     0>
            , <&key_physical_attrs 100 100 1200  237       0     0     0>
            , <&key_physical_attrs 100 100 1300  237       0     0     0>
            , <&key_physical_attrs 100 100  350  312       0     0     0>
            , <&key_physical_attrs 100 100  450  312    1200   450   412>
            , <&key_physical_attrs 100 100  548  328    2400   548   433>
            , <&key_physical_attrs 100 100  752  328  (-2400)  852   433>
            , <&key_physical_attrs 100 100  850  312  (-1200)  950   412>
            , <&key_physical_attrs 100 100  950  312       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
        // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
        // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
        //                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
                map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};

/ {
    input_processors {
        // Pinch to zoom, as keystrokes.
        zip_zoom_mapper: zip_zoom_mapper {
            compatible = "zmk,input-processor-zoom";
            #input-processor-cells = <0>;
            event-code = <INPUT_REL_MISC>;
            sensitivity = <10>;
#if defined(TOUCAN_WIN_MODE) || defined(TOUCAN_NIRI_MODE)
            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;
#else
            bindings = <&kp LG(MINUS)>, <&kp LG(EQUAL)>;
#endif
            track-remainders;
        };

        is_touching_processor: is_touching_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;

            codes = <INPUT_BTN_TOUCH>;      // watch for the 'touch' pseudo button
            // Hold the MOUSE layer while a finger is on the pad, so the thumb
            // keys become the mouse buttons (see config/toucan.keymap).
            bindings = <&mo TOUCAN_LAYER_MOUSE>;
        };

        // Three-finger swipes.
        swipe_button_mapper: swipe_button_mapper {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_NORTH INPUT_BTN_EAST INPUT_BTN_SOUTH INPUT_BTN_WEST>;
#if defined(TOUCAN_NIRI_MODE)
            bindings = <&kp LG(PAGE_UP)>, <&kp LG(L)>, <&kp LG(PAGE_DOWN)>, <&kp LG(H)>;
#elif defined(TOUCAN_WIN_MODE)
            bindings = <&kp LG(TAB)>, <&kp LG(RIGHT)>, <&kp LG(D)>, <&kp LG(LEFT)>;
#else
            bindings = <&kp LC(LG(UP))>, <&kp LC(LG(RIGHT))>, <&kp LC(LG(DOWN))>, <&kp LC(LG(LEFT))>;
#endif
        };
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        // On the peripheral this is bound to the pad; it forwards the pad's
        // events over the split link to the listener on the central.
        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split>;
        input-processors = <&zip_xy_scaler 100 100>, <&zip_scroll_scaler 1 20>,
                           <&zip_zoom_mapper>, <&is_touching_processor>,
                           <&swipe_button_mapper>;
        scroller {
            // Scroll on NAV only. On NAV the parent chain is replaced (no
            // 'process-next'), so resting a finger on the pad there does not
            // raise the MOUSE layer - movement becomes scrolling instead.
            layers = <TOUCAN_LAYER_NAV>;
            input-processors = <
                &zip_x_scaler 1 20
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 5
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            >;
        };
    };
};
